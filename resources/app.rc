#include <windows.h>

#ifdef FG_ASINVOKER
1 24 "app-asinvoker.manifest"
#else
1 24 "app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FiveMGuard"
            VALUE "FileDescription", "Preparacao do Windows Server 2012 R2 para FiveM"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "FiveMGuard"
            VALUE "OriginalFilename", "FiveMGuard.exe"
            VALUE "ProductName", "FiveMGuard"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Uso livre - consulte LICENSE"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
